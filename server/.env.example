# PRM Voice — voice server environment variables (spec §7).
# Copy to .env and fill in. `bot.py` loads this via python-dotenv.

# --- PRM API (the single CRUD layer — the Next.js app origin) ---
# e.g. http://localhost:3000 for local dev, or the deployed Vercel URL.
PRM_API_BASE_URL=http://localhost:3000

# --- Provider selection ---
# LLM provider for the voice + action worker LLMs: openai (default) | nvidia.
LLM_PROVIDER=openai
# STT provider: gradium (default / fallback) | nvidia (Parakeet).
STT_PROVIDER=gradium

# --- Gradium (TTS primary; STT fallback) ---
GRADIUM_API_KEY=
GRADIUM_VOICE_ID=

# --- OpenAI (LLM fallback / dev default) ---
OPENAI_API_KEY=
OPENAI_MODEL=

# --- NVIDIA Parakeet ASR (STT showcase) ---
# WebSocket URL of the NVIDIA ASR server (16 kHz PCM mono).
NVIDIA_ASR_URL=

# --- NVIDIA Nemotron LLM (LLM showcase, vLLM OpenAI-compatible) ---
NEMOTRON_LLM_URL=
NEMOTRON_LLM_MODEL=
NEMOTRON_LLM_API_KEY=
# Reasoning toggle — keep OFF (false/unset) for low-latency voice.
NEMOTRON_ENABLE_THINKING=false

# --- Runtime ---
# Set to "local" to disable the Krisp noise filter (Pipecat Cloud only).
ENV=local
