# PRM Voice — voice server env. Stack: NVIDIA Nemotron (LLM) + NVIDIA Parakeet
# (STT) + Gradium (TTS). Copy to .env and fill in; bot.py loads it via dotenv.

# The Next.js app origin (the single CRUD layer the voice tools call).
PRM_API_BASE_URL=http://localhost:3000

# --- NVIDIA Nemotron LLM (vLLM, OpenAI-compatible /v1) ---
NEMOTRON_LLM_URL=
NEMOTRON_LLM_MODEL=nvidia/nemotron-3-super
NEMOTRON_LLM_API_KEY=EMPTY
# Reasoning toggle — keep OFF (false) for low-latency voice.
NEMOTRON_ENABLE_THINKING=false

# --- NVIDIA Parakeet ASR (STT; 16-bit PCM, 16 kHz, mono over WebSocket) ---
NVIDIA_ASR_URL=

# --- Gradium (TTS) ---
GRADIUM_API_KEY=
GRADIUM_VOICE_ID=

# Set to "local" to disable the Pipecat Cloud Krisp filter.
ENV=local
